generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}
enum PostDisplay {
  BANNER
  CARDS
  BOTH
}
enum UserRole {
  ADMIN
  ADVERTISER
}
enum AdStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  EXPIRED
}
enum AdPlacement {
  HEADER
  HOME_BANNER
  HOME_CARDS
  CATEGORY_CARDS
  ALL_PAGES
  LEFT_RAIL
  LEFT_RAIL_BOTTOM
  RIGHT_RAIL
  RIGHT_RAIL_BOTTOM
}
enum AdHomeSlot {
  LEFT
  RIGHT
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role UserRole @default(ADMIN)
  phone String?
  active Boolean @default(true)
  advertisements Advertisement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Advertisement {
  id String @id @default(cuid())
  advertiserName String
  email String
  phone String
  title String
  titleTe String?
  description String?
  descriptionTe String?
  longDescription String? @db.Text
  longDescriptionTe String? @db.Text
  imageUrl String?
  linkUrl String?
  placement AdPlacement @default(HEADER)
  homeSlot AdHomeSlot?
  categoryId String?
  category Category? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
  startDate DateTime
  endDate DateTime
  days Int
  amount Int
  creativeCount Int @default(1)
  creativeNumber Int @default(1)
  bookingGroupId String?
  paymentReference String?
  changeCredits Int @default(0)
  changeRequestPending Boolean @default(false)
  status AdStatus @default(PENDING_PAYMENT)
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  clicks AdClick[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,startDate,endDate])
  @@index([bookingGroupId])
}

model AdClick {
  id String @id @default(cuid())
  advertisementId String
  advertisement Advertisement @relation(fields:[advertisementId],references:[id],onDelete:Cascade)
  clickType String @default("BANNER")
  sourceUrl String?
  userAgent String? @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
  @@index([advertisementId,createdAt])
  @@index([createdAt])
}

model AdSetting {
  id Int @id @default(1)
  pricePerDay Int @default(200)
  ownerEmail String @default("kotahgunduraviteja@gmail.com")
  ownerWhatsApp String @default("9985456884")
  paymentQrUrl String?
  paymentInstructions String @default("Scan the QR code and submit your payment reference. Approval normally takes up to 30 minutes.")
  updatedAt DateTime @updatedAt
}

model AdPlacementCapacity {
  placement AdPlacement @id
  capacity Int @default(5)
  updatedAt DateTime @updatedAt
}

model AdPlan {
  id String @id @default(cuid())
  name String
  days Int
  price Int
  billingLabel String @default("plan")
  note String?
  features String @db.Text
  theme String @default("slate")
  popular Boolean @default(false)
  active Boolean @default(true)
  order Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active,order])
}

model Subscriber {
  id String @id @default(cuid())
  email String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())
  name String
  nameTe String?
  slug String @unique
  description String?
  descriptionTe String?
  order Int @default(0)
  showInMenu Boolean @default(true)
  posts Post[]
  advertisements Advertisement[]
  parentId String?
  parent Category? @relation("CategoryTree",fields:[parentId],references:[id],onDelete:SetNull)
  children Category[] @relation("CategoryTree")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id String @id @default(cuid())
  title String
  titleTe String?
  slug String @unique
  excerpt String
  excerptTe String?
  content String @db.Text
  contentTe String? @db.Text
  imageUrl String?
  imageAlt String?
  status PostStatus @default(DRAFT)
  display PostDisplay @default(BOTH)
  featured Boolean @default(false)
  publishedAt DateTime?
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, publishedAt])
  @@index([categoryId])
}

model SiteSetting {
  id Int @id @default(1)
  siteName String @default("HealthPress")
  tagline String @default("Health stories for our global community")
  taglineTe String?
  logoUrl String?
  heroTitle String @default("Health that travels with you")
  heroTitleTe String?
  heroDescription String @default("Trusted wellness news, community stories and practical guidance for families everywhere.")
  heroDescriptionTe String?
  contactEmail String @default("hello@healthpress.example")
  facebookUrl String?
  instagramUrl String?
  youtubeUrl String?
  footerText String @default("Independent community health journalism.")
  footerTextTe String?
  updatedAt DateTime @updatedAt
}

model UploadedImage {
  id String @id @default(cuid())
  mimeType String
  data Bytes @db.LongBlob
  createdAt DateTime @default(now())
}
